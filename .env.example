# ==============================================================================
# TikTok Video Pipeline Environment Configuration
# Copy this file to .env and configure your secrets / credentials.
# In GitHub Actions, add these as Repository Secrets (Settings -> Secrets and variables -> Actions).
# ==============================================================================

# --- AI Story Generation (Google Gemini) ---
# Required if STORY_SOURCE is 'gemini' or fallback is triggered
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- Reddit Ingestion (Optional) ---
# If omitted, public Reddit JSON endpoints are used automatically.
# Create an app at https://www.reddit.com/prefs/apps (type: script)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TikTokStoryBot/1.0 (by /u/your_reddit_username)

# --- TikTok Official Posting API (Method A - Recommended) ---
# Register developer account at https://developers.tiktok.com/
# Create an app with 'video.upload' and 'video.publish' permissions
TIKTOK_ACCESS_TOKEN=your_tiktok_user_access_token
TIKTOK_CLIENT_KEY=your_app_client_key
TIKTOK_CLIENT_SECRET=your_app_client_secret
TIKTOK_REFRESH_TOKEN=your_refresh_token_optional

# --- TikTok Playwright Fallback (Method B) ---
# Extract 'sessionid' cookie value from web browser after logging into tiktok.com
TIKTOK_SESSION_ID=your_tiktok_web_session_id_cookie

# --- Background Video Configuration ---
# Source 1-hour satisfying restocking YouTube compilation
BACKGROUND_VIDEO_URL=https://www.youtube.com/watch?v=9or33zyZJgM
BACKGROUND_VIDEO_TOTAL_SECONDS=3600

# --- Video & Audio Settings ---
STORY_SOURCE=auto                    # Options: auto, reddit, gemini
TARGET_WORDS_MIN=450                 # ~3 min audio at ~155 WPM
TARGET_WORDS_MAX=520
VOICE_MALE=en-US-ChristopherNeural   # Fallback: en-US-GuyNeural
VOICE_FEMALE=en-US-JennyNeural       # Fallback: en-US-AriaNeural
BG_AUDIO_VOLUME_DB=-22               # ASMR background audio level in dB
VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
FONT_NAME=Montserrat ExtraBold
FONT_SIZE=72
